# Optional. Elexon Insights Solution APIs are public today; reserve this
# if access rules change.
ELEXON_API_KEY=

# Comma-separated origins for the API CORS middleware (Docker default: *).
CORS_ORIGINS=*

# Frontend build-time API origin. Leave empty for same-origin /api (nginx
# proxy in the frontend image). For docker-compose browser access to a
# published API port, use http://localhost:8000.
VITE_API_BASE=http://localhost:8000
